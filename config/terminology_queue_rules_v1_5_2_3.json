  "field_weights": {
    "approved_repair_action": 12,
    "approved_customer_complaint": 10,
    "structured_repair_action": 10,
    "diagnostic_note": 10,
    "special_notes_ocr": 4,
    "repairs_region_ocr": 2
  },
  "priority_formula": {
    "unique_repair_event_weight": 11,
    "unique_serial_weight": 7,
    "unique_model_weight": 3,
    "year_span_weight": 1,
    "raw_occurrence_weight": 1,
    "raw_occurrence_cap_per_event": 2,
    "ocr_only_penalty": 10,
    "single_serial_template_penalty_per_extra_event": 12,
    "single_serial_template_penalty_cap": 120,
    "acronym_shape_bonus_len_2_3": 6,
    "acronym_shape_bonus_len_4": 4,
    "acronym_shape_bonus_len_5": 1
  },
  "priority_labels": {
    "high_score": 125,
    "medium_score": 45,
    "high_unique_events": 12,
    "medium_unique_events": 3
  },
  "template_detection": {
    "minimum_unique_events": 3,
    "single_serial_ocr_fields": [
      "special_notes_ocr",
      "repairs_region_ocr"
    ],
    "context_signature_dominance_threshold": 0.65
  },
  "human_intervention": {
    "ask_now_only_if_high_priority_and_consequential": true,
    "consequential_fields": [
      "approved_repair_action",
      "approved_customer_complaint",
      "structured_repair_action",
      "diagnostic_note"
    ],
    "default_behavior": "queue_without_interrupting_processing"
  },
  "authority_shadowing": {
    "enabled": true,
    "human_approved_repair_action_shadows": [
      "structured_repair_action",
      "repairs_region_ocr"
    ],
    "preserve_unshadowed_fields": [
      "diagnostic_note",
      "special_notes_ocr",
      "approved_customer_complaint"
    ],
    "reason": "Human-approved repair wording supersedes lower-authority machine transcription for terminology discovery only. Lower-authority evidence remains in the audit trail."
  },
  "low_support_gates": {
    "two_char_ocr_only_min_unique_events": 3,
    "three_char_ocr_only_min_unique_events": 2,
    "apply_only_to_unresolved_terms": true,
    "reason": "Short OCR fragments are frequently initials or recognition noise; they require stronger event repetition before human review."
  }
}